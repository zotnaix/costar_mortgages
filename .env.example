# Co Star Mortgages - Environment Configuration Template
# Copy this file to .env and fill in your Supabase project credentials.
# NOTE: Never commit your actual .env file with production keys to Git.

# Supabase API Credentials (Get from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
