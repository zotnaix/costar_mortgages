{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/media/*", "/logo*.svg", "/*.{css,scss,js,png,gif,ico,jpg,svg,xml,txt}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
